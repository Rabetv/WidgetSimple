// =====================================================================
//  WidgetSimple – project settings. Edit the first block, then build.
// =====================================================================

// Your Apple Developer Team ID (10 characters, e.g. AB12CD34EF).
// You can also leave this empty and pick your team in Xcode under
// Target > Signing & Capabilities.
DEVELOPMENT_TEAM = HN6QY3V757

// Reverse-domain prefix for the bundle identifiers. Must be unique to you.
BUNDLE_ID_PREFIX = com.rabetv

// Name shown under the app icon. It must match the App Store name: the
// repository audit checks for "WidgetSimple" under Guideline 2.3.8.
HOME_SCREEN_NAME = WidgetSimple

// Label under each Home Screen widget. U+2800 (an invisible "blank" character)
// keeps the widget label empty without affecting the app's 2.3.8 display name.
WIDGET_SCREEN_NAME = ⠀

MARKETING_VERSION = 1.0.1
CURRENT_PROJECT_VERSION = 1

// ---------------------------------------------------------------------
//  Derived values – normally no need to touch these.
// ---------------------------------------------------------------------
APP_BUNDLE_ID = $(BUNDLE_ID_PREFIX).widgetsimple
WIDGET_BUNDLE_ID = $(APP_BUNDLE_ID).widget
APP_GROUP_ID = group.$(APP_BUNDLE_ID)

// iOS 27: apps open straight from the widget (RunSystemShortcutIntent).
IPHONEOS_DEPLOYMENT_TARGET = 27.0
SWIFT_VERSION = 5.0
